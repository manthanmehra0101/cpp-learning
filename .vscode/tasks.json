{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.out",

                // 1. ADDITIONAL INCLUDE DIRECTORIES
                "-I", "${workspaceFolder}/Dependency/GLFW/include",

                // 2. ADDITIONAL LIBRARY DIRECTORIES
                "-L", "${workspaceFolder}/Dependency/GLFW/lib-linux",

                // 3. ADDITIONAL DEPENDENCIES
                "-lglfw",
                "-lGL"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compiler: /usr/bin/g++"
        }
    ]
}